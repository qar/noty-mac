{
  "appId": "com.noty.mac",
  "productName": "Noty",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "src/renderer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "scripts/noty-status",
      "to": "noty-status"
    }
  ],
  "afterPack": "./build/afterPack.js",
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.utilities",
    "icon": "assets/icon.png",
    "identity": null,
    "hardenedRuntime": false,
    "extendInfo": {
      "NSAppleEventsUsageDescription": "Noty 需要发送 Apple Events 来激活终端（Kitty/Calendar/Safari 等）以完成通知跳转。"
    }
  }
}
