{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"]
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "dist", "release"]
}
