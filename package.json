{
  "name": "noty-mac",
  "version": "1.2.2",
  "description": "macOS 菜单栏应用，用于显示 ntfy.sh 通知",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "extract-asar": "cp -f release/mac-arm64/Noty.app/Contents/Resources/app.asar release/app.asar && echo 'Extracted app.asar to release/app.asar'"
  },
  "keywords": [
    "electron",
    "ntfy",
    "notifications",
    "macos",
    "menubar"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qar/noty-mac.git"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1"
  }
}
