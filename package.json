{
  "name": "noty-mac",
  "version": "1.2.3",
  "description": "macOS 菜单栏应用，用于显示 ntfy.sh 通知",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build:main": "tsc",
    "build:renderer": "node scripts/build-renderer.js",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac",
    "extract-asar": "cp -f release/mac-arm64/Noty.app/Contents/Resources/app.asar release/app.asar && echo 'Extracted app.asar to release/app.asar'"
  },
  "keywords": [
    "electron",
    "ntfy",
    "notifications",
    "macos",
    "menubar"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qar/noty-mac.git"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
